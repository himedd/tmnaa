# ============================================================================
# 300K Edits Wall — environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE=your_service_role_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- Storj gateways (S3-compatible). Up to 4 accounts. ----------------------
# BUCKET = the Storj bucket each access key was granted.
STORJ_BUCKET=
STORJ1_ACCESS_KEY=
STORJ1_SECRET_KEY=
STORJ1_ENDPOINT=https://gateway.storjshare.io
STORJ1_BUCKET=
STORJ2_ACCESS_KEY=
STORJ2_SECRET_KEY=
STORJ2_ENDPOINT=https://gateway.storjshare.io
STORJ2_BUCKET=
STORJ3_ACCESS_KEY=
STORJ3_SECRET_KEY=
STORJ3_ENDPOINT=https://gateway.storjshare.io
STORJ3_BUCKET=
STORJ4_ACCESS_KEY=
STORJ4_SECRET_KEY=
STORJ4_ENDPOINT=https://gateway.storjshare.io
STORJ4_BUCKET=

# --- Admin panel ------------------------------------------------------------
ADMIN_PASSWORD=super-strong-password
ADMIN_JWT_SECRET=long-random-string

# --- Upload limits / safety -------------------------------------------------
UPLOAD_MAX_PER_HOUR=6
MAX_IMAGE_MB=12
MAX_VIDEO_MB=150
ADMIN_TOKEN_HOURS=12